# ==============================================================================
# SWENTONELLI FAMILY DASHBOARD ENVIRONMENT CONFIGURATION
# ==============================================================================

# OPTION 1: Single Primary Google Calendar (Private iCal URL)
# To find this: In Google Calendar -> Settings for my calendar -> Integrate calendar -> Secret address in iCal format
GOOGLE_CALENDAR_ICAL_URL="https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID/private-xxxx/basic.ics"
GOOGLE_CALENDAR_NAME="Swentonelli Family"
GOOGLE_CALENDAR_COLOR="#3b82f6"

# OPTION 2: Multiple Family Member Calendars (JSON Array)
# GOOGLE_CALENDAR_SOURCES='[
#   {"id": "family", "name": "Family Shared", "icsUrl": "https://calendar.google.com/calendar/ical/.../basic.ics", "color": "#3b82f6"},
#   {"id": "dad", "name": "Dad (Work/Personal)", "icsUrl": "https://calendar.google.com/calendar/ical/.../basic.ics", "color": "#8b5cf6"},
#   {"id": "mom", "name": "Mom", "icsUrl": "https://calendar.google.com/calendar/ical/.../basic.ics", "color": "#ec4899"},
#   {"id": "school", "name": "School District", "icsUrl": "https://calendar.google.com/calendar/ical/.../basic.ics", "color": "#f59e0b"},
#   {"id": "sports", "name": "Kids Sports", "icsUrl": "https://calendar.google.com/calendar/ical/.../basic.ics", "color": "#10b981"}
# ]'

# Optional: Auto-Refresh Interval in Milliseconds (Defaults to 30000 = 30 seconds)
NEXT_PUBLIC_CALENDAR_REFRESH_MS=30000

